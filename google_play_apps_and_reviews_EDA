    "\n",
    "apps_path = Path(\"googleplaystore.csv\")\n",
    "reviews_path = Path(\"googleplaystore_user_reviews.csv\")\n",
    "if not apps_path.exists() or not reviews_path.exists():\n",
    "    raise FileNotFoundError(\"Keep both Google Play CSV files beside this notebook.\")\n",
    "\n",
    "apps_raw = pd.read_csv(apps_path)\n",
    "reviews_raw = pd.read_csv(reviews_path)\n",
    "print(\"App catalog shape:\", apps_raw.shape)\n",
    "print(\"Review table shape:\", reviews_raw.shape)\n",
    "display(apps_raw.head(3))\n",
    "display(reviews_raw.head(3))"
   ]
