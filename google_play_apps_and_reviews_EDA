    "print(\"Review summary App key unique:\", review_summary[\"App\"].is_unique)\n",
    "apps_with_reviews = apps_valid.merge(review_summary, on=\"App\", how=\"left\", validate=\"one_to_one\", indicator=True, suffixes=(\"_catalog\", \"_review\"))\n",
    "print(\"Rows after left merge:\", len(apps_with_reviews))\n",
    "display(apps_with_reviews[\"_merge\"].value_counts())\n",
