    "normal_demo = np.random.default_rng(RANDOM_SEED).normal(size=10000)\n",
    "demo_mean, demo_sd = normal_demo.mean(), normal_demo.std(ddof=1)\n",
    "rule_percentages = pd.Series({\n",
    "    \"within 1 standard deviation\": np.mean(np.abs(normal_demo - demo_mean) <= demo_sd) * 100,\n",
    "    \"within 2 standard deviations\": np.mean(np.abs(normal_demo - demo_mean) <= 2 * demo_sd) * 100,\n",
    "    \"within 3 standard deviations\": np.mean(np.abs(normal_demo - demo_mean) <= 3 * demo_sd) * 100,\n",
    "}, name=\"observed_percent\")\n",
    "display(rule_percentages.round(2).to_frame())\n",
    "sns.histplot(normal_demo, bins=40, stat=\"density\", color=\"steelblue\")\n",
    "plt.title(\"Simulated Normal Values for the Empirical Rule\")\n",
    "plt.xlabel(\"Simulated value\")\n",
    "plt.ylabel(\"Density\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
