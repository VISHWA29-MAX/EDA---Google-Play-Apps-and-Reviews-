   "source": [
    "install_log_values = apps_with_reviews[\"log_installs\"].dropna()\n",
    "q1, q3 = install_log_values.quantile([.25, .75])\n",
    "iqr = q3 - q1\n",
    "lower_fence, upper_fence = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "iqr_mask = (install_log_values < lower_fence) | (install_log_values > upper_fence)\n",
    "z_scores = (install_log_values - install_log_values.mean()) / install_log_values.std(ddof=0)\n",
    "z_mask = z_scores.abs() > 3\n",
    "outlier_counts = pd.DataFrame({\n",
    "    \"method\": [\"IQR fences on log installs\", \"absolute Z-score > 3 on log installs\"],\n",
    "    \"count\": [int(iqr_mask.sum()), int(z_mask.sum())],\n",
    "})\n",
    "outlier_counts[\"percent\"] = outlier_counts[\"count\"] / len(install_log_values) * 100\n",
    "display(outlier_counts.round(2))\n",
    "\n",
    "retained = install_log_values.loc[~iqr_mask]\n",
    "capped = install_log_values.clip(lower=lower_fence, upper=upper_fence)\n",
    "outlier_comparison = pd.DataFrame({\n",
    "    \"original\": [install_log_values.mean(), install_log_values.median(), install_log_values.std(), install_log_values.max()],\n",
    "    \"IQR flagged removed\": [retained.mean(), retained.median(), retained.std(), retained.max()],\n",
    "    \"IQR capped\": [capped.mean(), capped.median(), capped.std(), capped.max() - capped.min()],\n",
    "}, index=[\"mean log installs\", \"median log installs\", \"standard deviation\", \"range\"])\n",
    "display(outlier_comparison.round(3))"
