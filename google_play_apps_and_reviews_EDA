    "apps_work = apps_raw.drop_duplicates().copy()\n",
    "apps_work[\"last_updated_date\"] = pd.to_datetime(apps_work[\"Last Updated\"], errors=\"coerce\")\n",
    "apps_work[\"rating_numeric\"] = pd.to_numeric(apps_work[\"Rating\"], errors=\"coerce\")\n",
    "apps_work[\"review_count\"] = pd.to_numeric(apps_work[\"Reviews\"].astype(\"string\").str.replace(\",\", \"\", regex=False), errors=\"coerce\")\n",
    "apps_work[\"installs_lower_bound\"] = pd.to_numeric(apps_work[\"Installs\"].astype(\"string\").str.replace(\",\", \"\", regex=False).str.replace(\"+\", \"\", regex=False), errors=\"coerce\")\n",
    "apps_work[\"price_usd\"] = pd.to_numeric(apps_work[\"Price\"].astype(\"string\").str.replace(\"$\", \"\", regex=False), errors=\"coerce\")\n",
    "\n",
    "def size_to_mb(value):\n",
    "    if pd.isna(value):\n",
    "        return np.nan\n",
    "    value = str(value).strip()\n",
    "    if value.endswith(\"M\"):\n",
    "        return pd.to_numeric(value[:-1], errors=\"coerce\")\n",
    "    if value.endswith(\"k\"):\n",
    "        return pd.to_numeric(value[:-1], errors=\"coerce\") / 1024\n",
    "    return np.nan\n",
    "\n",
    "apps_work[\"size_mb\"] = apps_work[\"Size\"].map(size_to_mb)\n",
    "apps_work[\"genre_count\"] = apps_work[\"Genres\"].astype(\"string\").str.split(\";\").str.len()\n",
    "apps_work[\"is_free\"] = apps_work[\"Type\"].map({\"Free\": True, \"Paid\": False}).astype(\"boolean\")\n",
    "apps_work[\"update_year\"] = apps_work[\"last_updated_date\"].dt.year\n",
    "apps_work[\"update_month\"] = apps_work[\"last_updated_date\"].dt.month\n",
    "apps_work[\"malformed_rating\"] = apps_work[\"rating_numeric\"].notna() & ~apps_work[\"rating_numeric\"].between(1, 5)\n",
    "\n",
    "print(\"Rows after exact-duplicate removal:\", len(apps_work))\n",
    "print(\"Rows with malformed rating:\", apps_work[\"malformed_rating\"].sum())\n",
    "print(\"Rows with missing App name:\", apps_work[\"App\"].isna().sum())\n",
    "apps_valid = apps_work.loc[~apps_work[\"malformed_rating\"] & apps_work[\"App\"].notna() & apps_work[\"Category\"].notna()].copy()\n",
    "apps_valid = apps_valid.sort_values(\"last_updated_date\").drop_duplicates(\"App\", keep=\"last\")\n",
    "print(\"One-row-per-app analysis table:\", apps_valid.shape)\n",
    "\n",
    "feature_notes = pd.DataFrame({\n",
    "    \"feature\": [\"review_count\", \"installs_lower_bound\", \"price_usd\", \"size_mb\", \"genre_count\", \"is_free\", \"update_year/month\"],\n",
    "    \"source or formula\": [\"numeric conversion of Reviews\", \"remove comma and plus from Installs\", \"remove dollar sign from Price\", \"M as MB; k converted to MB\", \"number of semicolon-separated genres\", \"Type equals Free\", \"parsed Last Updated date\"],\n",
    "    \"note\": [\"count in dataset snapshot\", \"install band lower bound, not exact\", \"price in dollars\", \"Varies with device becomes missing\", \"label count, not product count\", \"boolean category feature\", \"date parse failures remain missing\"],\n",
    "    \"data_type\": [str(apps_valid[c].dtype) for c in [\"review_count\", \"installs_lower_bound\", \"price_usd\", \"size_mb\", \"genre_count\", \"is_free\", \"update_year\"]],\n",
    "    \"missing treatment\": [\"unparseable counts remain missing\", \"non-numeric bands remain missing\", \"unparseable values remain missing\", \"device-dependent size remains missing\", \"missing genre stays missing\", \"unknown Type is not inferred\", \"unparseable dates become NaT\"],\n",
    "})\n",
