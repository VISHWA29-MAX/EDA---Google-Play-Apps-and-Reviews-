    "reviews_clean = reviews_raw.dropna(subset=[\"App\", \"Translated_Review\", \"Sentiment\"]).copy()\n",
    "reviews_clean[\"Sentiment_Polarity\"] = pd.to_numeric(reviews_clean[\"Sentiment_Polarity\"], errors=\"coerce\")\n",
    "reviews_clean[\"Sentiment_Subjectivity\"] = pd.to_numeric(reviews_clean[\"Sentiment_Subjectivity\"], errors=\"coerce\")\n",
    "reviews_clean = reviews_clean.loc[\n",
    "    reviews_clean[\"Sentiment_Polarity\"].between(-1, 1) & reviews_clean[\"Sentiment_Subjectivity\"].between(0, 1)\n",
    "].copy()\n",
    "\n",
    "sentiment_map = {\"Positive\": \"positive\", \"Negative\": \"negative\", \"Neutral\": \"neutral\"}\n",
    "reviews_clean[\"sentiment_group\"] = reviews_clean[\"Sentiment\"].map(sentiment_map)\n",
    "review_summary = reviews_clean.groupby(\"App\").agg(\n",
    "    review_count=(\"Translated_Review\", \"count\"),\n",
    "    mean_polarity=(\"Sentiment_Polarity\", \"mean\"),\n",
    "    mean_subjectivity=(\"Sentiment_Subjectivity\", \"mean\"),\n",
    "    positive_share=(\"sentiment_group\", lambda s: (s == \"positive\").mean()),\n",
    "    negative_share=(\"sentiment_group\", lambda s: (s == \"negative\").mean()),\n",
    "    neutral_share=(\"sentiment_group\", lambda s: (s == \"neutral\").mean()),\n",
    ").reset_index()\n",
    "\n",
    "integration_plan = pd.DataFrame({\n",
    "    \"table\": [\"apps_valid\", \"review_summary\"],\n",
    "    \"row grain\": [\"one row per App after catalog duplicate handling\", \"one row per App after grouping valid review rows\"],\n",
    "    \"key\": [\"App\", \"App\"],\n",
    "    \"expected relationship\": [\"one catalog row per app\", \"one review summary row per app\"],\n",
    "    \"join decision\": [\"retain the catalog as the left table\", \"aggregate before joining and check unmatched keys\"],\n",
    "})\n",
    "display(integration_plan)\n",
    "print(\"App rows before merge:\", len(apps_valid), \"| unique keys:\", apps_valid[\"App\"].nunique())\n",
