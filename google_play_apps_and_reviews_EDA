    "category_summary = apps_valid.groupby(\"Category\", observed=True).agg(\n",
    "    app_count=(\"App\", \"nunique\"),\n",
    "    median_rating=(\"rating_numeric\", \"median\"),\n",
    "    median_installs_lower_bound=(\"installs_lower_bound\", \"median\"),\n",
    "    mean_price=(\"price_usd\", \"mean\"),\n",
    "    paid_share=(\"is_free\", lambda s: 1 - s.mean()),\n",
    ").sort_values(\"app_count\", ascending=False)\n",
    "apps_valid[\"category_mean_rating\"] = apps_valid.groupby(\"Category\", observed=True)[\"rating_numeric\"].transform(\"mean\")\n",
    "apps_valid[\"rating_minus_category_mean\"] = apps_valid[\"rating_numeric\"] - apps_valid[\"category_mean_rating\"]\n",
    "display(category_summary.head(12).round(2))"
   ]
